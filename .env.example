# 复制成 .env 再填写。.env 已在 .gitignore 中，不会被提交；不要把真实的 Key 写进本文件。
# 也可以不用 .env：在网页右上角“设置”里选服务商、填 Key（只保存在本机）。
# 填一家就够了；都填了的话，默认用排在前面的（国内的在前）。

# 智谱 GLM（推荐：国内直连，GLM-4.7-Flash 免费）：https://open.bigmodel.cn/usercenter/proj-mgmt/apikeys
ZHIPU_API_KEY=
# 硅基流动（有免费的小模型）：https://cloud.siliconflow.cn/account/ak
# SILICONFLOW_API_KEY=
# 通义千问（阿里云百炼，新用户有免费额度）：https://bailian.console.aliyun.com/?apiKey=1
# DASHSCOPE_API_KEY=
# DeepSeek（付费，便宜）：https://platform.deepseek.com/api_keys
# DEEPSEEK_API_KEY=
# Kimi（付费）：https://platform.moonshot.cn/console/api-keys
# MOONSHOT_API_KEY=
# Google Gemini（中国大陆不能直接访问）：https://aistudio.google.com/apikey （不要给项目开启结算）
# GEMINI_API_KEY=

# 可选
# LLM_PROVIDER=zhipu        # zhipu / siliconflow / dashscope / deepseek / moonshot / gemini / custom
# LLM_MODEL=glm-4.7-flash
# LLM_BASE_URL=             # 只有 custom（自定义 OpenAI 兼容接口）需要
# CUSTOM_API_KEY=
# LLM_TIMEOUT_S=            # 解析一句话的超时（秒），不填用服务商的默认值
# ACG_LOG_DIR=data/logs
